{
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.27.12",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.23.5",
    "typescript": "^6.0.2",
    "ultracite": "^7.8.0",
    "vitest": "^4.1.2"
  },
  "name": "junobuild-mcp-server",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "JUNO_E2E=true vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "type": "module",
  "version": "1.5.0",
  "description": "MCP server for Juno (junobuild) - manage satellites, hosting, functions, snapshots and more",
  "license": "MIT",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "junobuild-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nami2111/junobuild-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nami2111/junobuild-mcp/issues"
  },
  "homepage": "https://github.com/nami2111/junobuild-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "juno",
    "junobuild",
    "serverless",
    "internet-computer",
    "satellite",
    "hosting",
    "deploy"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
